# Generated by `docker compose up` and `provision.sh`: a database, a media store,
# signing keys and a self-signed certificate. All reproducible, none worth keeping,
# and the keys should not be in a repository at all.
synapse/homeserver.db*
synapse/media_store/
synapse/*.signing.key
synapse/*.tls.key
synapse/*.tls.crt
synapse/homeserver.yaml
synapse/*.log.config
